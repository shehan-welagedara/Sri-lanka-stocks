# Public site URL (used for links and the Android shell)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin key for /admin (moderation queue, verification, promotions). REQUIRED in production.
ADMIN_KEY=change-me

# Market data: "cse" (public cse.lk endpoints, shown as delayed) or "sample"
MARKET_DATA_SOURCE=cse

# Google AdSense publisher id (leave empty to show house-ad placeholders)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Supabase (phase 2 - see supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
